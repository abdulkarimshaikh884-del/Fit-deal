# Copy to .env for local work (it is git-ignored). On Render, add the same
# names under Environment. Never put real values in this file or in git.

# ── Site ───────────────────────────────────────────────────────────────────
NODE_ENV=development            # production on Render
SITE_URL=http://localhost:5173  # https://fitdeal.shop in production, https://<staging>.onrender.com on staging
EXTRA_ORIGINS=                  # other addresses allowed to call the API, comma separated
NOINDEX=true                    # true keeps search engines out; set false only on the live fitdeal.shop
PORT=5173

# ── Photo recognition (Google AI Studio → API key) ─────────────────────────
# Turn on billing for this key: on the free tier Google may use requests to
# improve its products, which our privacy policy does not allow.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Database (Supabase → Project settings → API) ───────────────────────────
# The service key bypasses row security. Server only, never in page code.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Product sources ────────────────────────────────────────────────────────
# Flipkart Affiliate: affiliate.flipkart.com → API token
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
# Amazon Creators API: available after 10 qualifying sales in 30 days
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=             # your Associates tag, e.g. fitdeal-21 (also used on links without the API)
# Google Shopping results through serper.dev (paid, fills Myntra/AJIO gaps)
SERPER_API_KEY=

# ── Affiliate links ────────────────────────────────────────────────────────
# Deep-link template from Cuelinks (or similar) for Myntra and AJIO.
# {url} = the product address, {subid} = our click reference.
AFFILIATE_NETWORK_TEMPLATE=

# ── Admin, analytics, monitoring ───────────────────────────────────────────
ADMIN_PASSWORD=                 # long random password; /admin is off without it
ANALYTICS_SALT=                 # long random string; change it to rotate visitor hashes
ERROR_WEBHOOK_URL=              # optional Discord/Slack webhook for server errors
COST_PER_ANALYSIS_INR=          # optional, for the admin cost-per-visitor figure
COST_PER_SEARCH_INR=
# Explicit local previews only; fictional catalog is never allowed in production.
ENABLE_SAMPLE_CATALOG=false
